# ---------- Database ----------
# Docker: use a password with only letters and numbers. In DATABASE_URL, special characters must be URL-encoded (@ becomes %40).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR PASSWORD
POSTGRES_DB=lumora_candles
# Local (no Docker): host=localhost. Docker Compose overrides host to "postgres".
DATABASE_URL="YOUR_DATABASE_URL"

# ---------- Server ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# ---------- Razorpay (use TEST keys: rzp_test_...) ----------
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=

# ---------- Pricing rules ----------
GST_RATE=18
SHIPPING_FEE=99
FREE_SHIPPING_THRESHOLD=999
COD_ENABLED=true
COD_MAX_ORDER_VALUE=10000

# ---------- Seeded admin (change before production) ----------
ADMIN_EMAIL=adt@lumora.test
ADMIN_PASSWORD=Adt@123

# ---------- Client (Vite) ----------
VITE_API_URL=http://localhost:5000/api
